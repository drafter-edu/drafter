{
	"version": "0.2.0",
	"configurations": [
		{
			"type": "node",
			"request": "launch",
			"name": "Debug Transpile Test",
			"cwd": "${workspaceFolder}/js",
			"runtimeExecutable": "npm",
			"runtimeArgs": [
				"run",
				"test",
				"--",
				"src/__tests__/transpiler/transpile.test.ts"
			],
			"skipFiles": ["<node_internals>/**"]
		}
	]
}
